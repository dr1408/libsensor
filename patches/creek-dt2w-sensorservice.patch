+    // Creek: mirror HyperOS' virtual-proximity client filtering.
+    // SensorEventConnection::getPackageName() is the application package,
+    // normally com.android.systemui, not the Java ThresholdSensorImpl class.
+    char device[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.product.vendor.device", device, "");
+    if (device[0] == '\0') {
+        property_get("ro.product.device", device, "");
+    }
+    const String8 sensorName = sensor->getSensor().getName();
+    const String8 clientName = connection->getPackageName();
+    const bool isVirtualProximity =
+            sensor->getSensor().getType() == SENSOR_TYPE_PROXIMITY &&
+            (sensorName == "Virtual Proximity Sensor" ||
+             sensorName == "virtual ps Proximity Sensor");
+    if (isVirtualProximity) {
+        ALOGI("Creek virtual-proximity request: device=%s sensor=%s type=%d "
+              "handle=%d package=%s opPackage=%s",
+              device, sensorName.c_str(), sensor->getSensor().getType(),
+              handle, clientName.c_str(), String8(opPackageName).c_str());
+    }
+
+    // Set persist.vendor.creek.block_virtual_psensor=0 to log without blocking.
+    char blockVirtualPsensor[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.vendor.creek.block_virtual_psensor",
+                 blockVirtualPsensor, "1");
+    const bool shouldBlock = strcmp(blockVirtualPsensor, "0") != 0;
+    if (!strcmp(device, "creek") && isVirtualProximity && shouldBlock &&
+        clientName == "com.android.systemui") {
+        ALOGW("Creek DT2W: denying virtual proximity to package=%s "
+              "opPackage=%s sensor=%s",
+              clientName.c_str(), String8(opPackageName).c_str(),
+              sensorName.c_str());
+        return PERMISSION_DENIED;
+    }
+
